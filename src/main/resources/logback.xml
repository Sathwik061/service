<?xml version="1.0" encoding="UTF-8"?>
<!-- debug="true" prints Logback's internal status to console so we can see if appenders fail to start -->
<configuration debug="true">

    <!-- Explicitly define properties from env vars (with fallback defaults) -->
    <property name="SPLUNK_HEC_URL"   value="${SPLUNK_HEC_URL:-https://inputs.prd-p-0hb92.splunkcloud.com:8088}"/>
    <property name="SPLUNK_HEC_TOKEN" value="${SPLUNK_HEC_TOKEN:-5e8221bb-801a-4d26-a277-eaaa8c16bf82}"/>

    <!-- ─── Console Appender ─────────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Splunk HEC Appender ───────────────────────────────────────────── -->
    <appender name="SPLUNK" class="com.camunda.academy.logging.SplunkHecAppender">
        <url>${SPLUNK_HEC_URL}</url>
        <token>${SPLUNK_HEC_TOKEN}</token>
        <source>camunda-order-workers</source>
        <sourcetype>camunda:java:worker</sourcetype>
        <index>main</index>

        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- Async wrapper — non-blocking, 512-event queue -->
    <appender name="SPLUNK_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="SPLUNK"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ─── Logger Levels ─────────────────────────────────────────────────── -->
    <logger name="io.camunda" level="WARN"/>
    <logger name="io.grpc"    level="WARN"/>
    <logger name="io.netty"   level="WARN"/>
    <logger name="com.camunda.academy" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SPLUNK_ASYNC"/>
    </root>

</configuration>
